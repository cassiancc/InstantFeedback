{
	"schemaVersion": 1,
	"id": "instantfeedback",
	"version": "${version}",
	"name": "InstantFeedback for Vanilla Backport",
	"description": "Implements the most requested features from feedback.minecraft.net. A backport of InstantFeedback to 1.20.1 made to work with Vanilla Backport.",
	"authors": [
		"Drex",
		"Hallowed"
	],
	"license": "MIT",
	"icon": "assets/instantfeedback/icon.png",
	"contact": {
		"homepage": "https://modrinth.com/project/instant-feedback-backport",
		"issues": "https://github.com/CashMoney30/InstantFeedback/issues",
		"sources": "https://github.com/CashMoney30/InstantFeedback/"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"me.drex.instantfeedback.InstantFeedback"
		],
		"client": [
			"me.drex.instantfeedback.InstantFeedbackClient",
			"me.drex.instantfeedback.InstantFeedbackEmissiveHandler"
		],
		"fabric-datagen": [
			"me.drex.instantfeedback.datagen.InstantFeedbackDataGenerator"
		]
	},
	"accessWidener": "instantfeedback.accesswidener",
	"mixins": [
		"instantfeedback.mixins.json",
		{
			"config": "instantfeedback.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.10",
		"java": ">=17",
		"fabric-api": "*",
		"vanillabackport": ">=1.1.7"
	}
}