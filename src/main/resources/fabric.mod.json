{
	"schemaVersion": 1,
	"id": "instantfeedback",
	"version": "${version}",
	"name": "Perfect Parity: InstantFeedback",
	"description": "Implements the most requested features from feedback.minecraft.net. An unofficial backport of InstantFeedback that works with the Perfect Parity mods.",
	"authors": [
		"Drex",
		"cassiancc"
	],
	"license": "MIT",
	"icon": "assets/instantfeedback/icon.png",
	"contact": {
		"homepage": "",
		"issues": "https://github.com/cassiancc/InstantFeedback/issues",
		"sources": "https://github.com/cassiancc/InstantFeedback/"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"me.drex.instantfeedback.InstantFeedback"
		],
		"client": [
			"me.drex.instantfeedback.InstantFeedbackClient"
		],
		"fabric-datagen": [
			"me.drex.instantfeedback.datagen.InstantFeedbackDataGenerator"
		]
	},
	"accessWidener": "instantfeedback.accesswidener",
	"mixins": [
		"instantfeedback.mixins.json",
		{
			"config": "instantfeedback.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.5",
		"java": ">=21",
		"fabric-api": "*",
		"perfect-parity-pg": "*",
		"perfectparity": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.cassian.cc"
			}
		}
	}
}