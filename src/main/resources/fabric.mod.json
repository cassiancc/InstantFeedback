{
	"schemaVersion": 1,
	"id": "instantfeedback",
	"version": "${version}",
	"name": "InstantFeedback for Vanilla Backport",
	"description": "Implements the most requested features from feedback.minecraft.net. A backport of InstantFeedback to 1.21.1 designed to work alongside Vanilla Backport.",
	"authors": [
		"Drex",
	  	"cassiancc"
	],
	"license": "MIT",
	"icon": "assets/instantfeedback/icon.png",
	"contact": {
		"homepage": "https://modrinth.com/project/instant-feedback-backport",
		"issues": "https://github.com/cassiancc/InstantFeedback/issues",
		"sources": "https://github.com/cassiancc/InstantFeedback/"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"me.drex.instantfeedback.InstantFeedback"
		],
		"client": [
			"me.drex.instantfeedback.InstantFeedbackClient"
		],
		"fabric-datagen": [
			"me.drex.instantfeedback.datagen.InstantFeedbackDataGenerator"
		]
	},
	"mixins": [
		"instantfeedback.mixins.json",
		{
			"config": "instantfeedback.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.5",
		"java": ">=21",
		"fabric-api": "*",
	  	"vanillabackport": "*",
        "minecraft": "1.21.1"
	},
    "recommends": {
      "continuity": "*"
    }
}